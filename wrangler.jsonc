{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startup-jury",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Route everything EXCEPT the hashed build output through the Worker, so
    // the SPA document always picks up the security headers from
    // src/server/security.ts. Without this the edge served navigations a
    // cached `index.html` variant (cf-cache-status: HIT, content-encoding:
    // zstd) that predated the header, while a plain curl — a different cache
    // variant — got the fresh one: the CSP reached tooling but not browsers.
    // `/assets/*` is content-hashed and immutable, so it still goes straight
    // to the Asset Worker and keeps its edge caching.
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.png"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "startup-jury-db",
      "database_id": "6353d3a9-e2f0-459a-9acc-411373197232",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "a6b70566774d4f03900a05c5c77f1365"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DECKS",
      "bucket_name": "startup-jury-decks"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVAL_QUEUE",
        "queue": "startup-jury-evals"
      }
    ],
    "consumers": [
      {
        "queue": "startup-jury-evals",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        // Session 7 (FINISH-PLAN §9). Without this, a message that exhausted its
        // retries was DROPPED: the deck stayed at `pending_ai` forever, the
        // credit stayed spent, and no reason was recorded anywhere. Now it lands
        // on the dead-letter queue below, where `handleQueue` marks the deck
        // failed and refunds the credit.
        // NB `wrangler queues create startup-jury-evals-dlq` must run before the
        // first deploy that references it.
        "dead_letter_queue": "startup-jury-evals-dlq"
      },
      {
        "queue": "startup-jury-evals-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        // The dead-letter handler only writes a status + a refund; if THAT
        // fails, one retry is plenty (it acks unconditionally afterwards).
        "max_retries": 1
      }
    ]
  },
  // Cloudflare Email Sending (src/server/email/outbox.ts). The binding is safe to
  // deploy before a domain is onboarded — sending is additionally gated on the
  // EMAIL_FROM var below, so until that is set every message is recorded in
  // `email_outbox` with status='recorded' and nothing is dispatched.
  //
  // TO GO LIVE (one config change + a redeploy, no code change):
  //   1. Onboard the sending domain — Dashboard → Compute & AI → Email Service →
  //      Email Sending → Onboard Domain (adds the SPF/DKIM records), or
  //      `npx wrangler email sending enable <domain>`.
  //   2. Set "EMAIL_FROM" below to a verified address on that domain
  //      (e.g. "no-reply@<domain>"), optionally EMAIL_REPLY_TO.
  //   3. `npx wrangler deploy`.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Public origin used to build the tokenized founder resubmit links.
    "APP_BASE_URL": "https://startup-jury.jay-komarraju.workers.dev",
    // Verified From address. EMPTY = no delivery attempted (audit-only outbox).
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "ai.STARTUPJURY",
    "EMAIL_REPLY_TO": ""
  },
  "triggers": {
    // "0 8 * * *"    — daily evaluator-reminder sweep (runReminders).
    // "*/10 * * * *" — re-drive decks stranded at `pending_ai` (runStuckSweep).
    //                  `src/server/index.ts` branches on `controller.cron`.
    "crons": ["0 8 * * *", "*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
